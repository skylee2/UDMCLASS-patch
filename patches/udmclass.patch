+/* UDM helper. Insert the KG-to-fluid perturbation transition as
+   an accepted integration interval boundary for scalar UDM modes. For
+   delay_factor=1 this is exactly the historical tau_osc boundary. */
+static int perturbations_udm_insert_tau_osc_interval(
+                                                     struct precision * ppr,
+                                                     struct background * pba,
+                                                     struct perturbations * ppt,
+                                                     int index_md,
+                                                     int ppw_ap_size,
+                                                     int * p_interval_number,
+                                                     double ** p_interval_limit,
+                                                     int *** p_interval_approx,
+                                                     int * p_inserted,
+                                                     int * p_insert_index,
+                                                     double * p_tau_osc
+                                                     ) {
+  int interval_number, index_interval, index_ap, split_index;
+  double tau_osc, z_fluid, tolerance;
+  double * old_interval_limit;
+  double * new_interval_limit;
+  int ** old_interval_approx;
+  int ** new_interval_approx;
+
+  *p_inserted = _FALSE_;
+  *p_insert_index = -1;
+  *p_tau_osc = 0.;
+
+  if ((pba->has_udm == _FALSE_) || (index_md != ppt->index_md_scalars))
+    return _SUCCESS_;
+
+  z_fluid = perturbations_udm_z_fluid_transition(pba); /* UDM generalized transition redshift */
+  class_call(background_tau_of_z(pba,
+                                 z_fluid,
+                                 &tau_osc),
+             pba->error_message,
+             ppt->error_message);
+
+  if (!isfinite(tau_osc))
+    return _SUCCESS_;
+
+  interval_number = *p_interval_number;
+  old_interval_limit = *p_interval_limit;
+  old_interval_approx = *p_interval_approx;
+
+  if ((tau_osc <= old_interval_limit[0]) ||
+      (tau_osc >= old_interval_limit[interval_number]))
+    return _SUCCESS_;
+
+  tolerance = ppr->tol_tau_approx*MAX(tau_osc,1.);
+  for (index_interval=0; index_interval<=interval_number; index_interval++) {
+    if (fabs(tau_osc-old_interval_limit[index_interval]) <= tolerance)
+      return _SUCCESS_;
+  }
+
+  split_index = -1;
+  for (index_interval=0; index_interval<interval_number; index_interval++) {
+    if ((old_interval_limit[index_interval] < tau_osc) &&
+        (tau_osc < old_interval_limit[index_interval+1])) {
+      split_index = index_interval;
+      break;
+    }
+  }
+
+  if (split_index < 0)
+    return _SUCCESS_;
+
+  class_alloc(new_interval_limit,
+              (interval_number+2)*sizeof(double),
+              ppt->error_message);
+
+  class_alloc(new_interval_approx,
+              (interval_number+1)*sizeof(int *),
+              ppt->error_message);
+
+  for (index_interval=0; index_interval<interval_number+1; index_interval++) {
+    class_alloc(new_interval_approx[index_interval],
+                ppw_ap_size*sizeof(int),
+                ppt->error_message);
+  }
+
+  for (index_interval=0; index_interval<=split_index; index_interval++)
+    new_interval_limit[index_interval] = old_interval_limit[index_interval];
+  new_interval_limit[split_index+1] = tau_osc; /* tau_fluid; variable name retained for default-path continuity */
+  for (index_interval=split_index+1; index_interval<=interval_number; index_interval++)
+    new_interval_limit[index_interval+1] = old_interval_limit[index_interval];
+
+  for (index_interval=0; index_interval<interval_number+1; index_interval++) {
+    int source_interval = index_interval;
+    if (index_interval > split_index+1)
+      source_interval = index_interval-1;
+    else if (index_interval == split_index+1)
+      source_interval = split_index;
+
+    for (index_ap=0; index_ap<ppw_ap_size; index_ap++)
+      new_interval_approx[index_interval][index_ap] = old_interval_approx[source_interval][index_ap];
+  }
+
+  for (index_interval=0; index_interval<interval_number; index_interval++)
+    free(old_interval_approx[index_interval]);
+  free(old_interval_approx);
+  free(old_interval_limit);
+
+  *p_interval_number = interval_number+1;
+  *p_interval_limit = new_interval_limit;
+  *p_interval_approx = new_interval_approx;
+  *p_inserted = _TRUE_;
+  *p_insert_index = split_index+1;
+  *p_tau_osc = tau_osc; /* tau_fluid for non-default delay */
+
+  return _SUCCESS_;
+}
