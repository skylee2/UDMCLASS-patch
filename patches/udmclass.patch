+/* UDM effective sound speed. With
+   rho_CLASS=rho_phys/(3*Mpl_red_CLASS^2) and the canonical KG coefficient
+   udm_lambda_kg_class=3*lambda*Mpl_red_CLASS^2, the combination
+   udm_lambda_kg_class*rho_CLASS/m^4 is already the physical
+   Y=lambda*rho_phys/m^4.  No additional Planck/mass conversion belongs here. */
+static double perturbations_udm_cs2(
+                                    struct background * pba,
+                                    double k,
+                                    double a,
+                                    double rho_udm
+                                    ) {
+  double grad, self, numerator, denominator, cs2;
+
+  if ((a <= 0.) || (pba->udm_m <= 0.) || (rho_udm < 0.))
+    return 0.;
+
+  grad = pow(k/(2.*pba->udm_m*a),2);
+  self = pba->udm_lambda_kg_class*rho_udm/pow(pba->udm_m,4);
+
+  numerator = grad + 3.*self/4.;
+  denominator = 1. + grad + 9.*self/4.;
+
+  if ((denominator <= 0.) || !isfinite(numerator) || !isfinite(denominator))
+    return 0.;
+
+  cs2 = numerator/denominator;
+
+  if (!isfinite(cs2))
+    return 0.;
+  if (cs2 < 0.)
+    return 0.;
+  if (cs2 > 1.)
+    return 1.;
+
+  return cs2;
+}
