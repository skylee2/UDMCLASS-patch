+/* UDM contribution to total-matter bookkeeping. */
+static double perturbations_udm_matter_weight(
+                                             struct background * pba,
+                                             double a,
+                                             double w_udm
+                                             ) {
+  double a_fluid, weight;
+
+  a_fluid = perturbations_udm_a_fluid_transition(pba);
+  if (a < a_fluid)
+    weight = 0.;
+  else
+    weight = 1. - 3.*w_udm;
+
+  if (weight < 0.)
+    weight = 0.;
+  if (weight > 1.)
+    weight = 1.;
+  if (!isfinite(weight))
+    weight = 0.;
+
+  return weight;
+}
