+/* UDM helper. Apply KG-to-fluid reinitialization only at an
+   accepted tau_osc interval boundary, after perturbations_vector_init() has
+   copied the previous accepted state into the new interval vector. This is
+   deliberately outside perturbations_derivs(), so rejected trial steps cannot
+   mutate the matching state. The UDM smooth gate remains active until
+   UDM. */
+static int perturbations_udm_apply_tau_osc_reinit(
+                                                  struct background * pba,
+                                                  struct perturbations * ppt,
+                                                  int index_md,
+                                                  int index_ic,
+                                                  int index_k,
+                                                  double k,
+                                                  double tau_reinit,
+                                                  struct perturbations_workspace * ppw
+                                                  ) {
+  double a, delta_udm, theta_udm, theta_kg_candidate, theta_reinit_used, delta_p_udm;
+  double delta_phi_udm, delta_phi_prime_udm;
+  double rho_udm, p_udm, phi_prime_udm, theta_denominator;
+  double active_delta_udm, active_theta_udm;
+  double stage2c_avg_rho=0., stage2c_avg_p=0., stage2c_avg_delta_rho=0.;
+  double stage2c_avg_momentum=0., stage2c_avg_delta_p=0.;
+  double rho_post_background, p_post_background, rho_plus_p_post_background;
+  double * pvecback_fluid = NULL;
+  int stage2c_average_available;
+
+  if ((pba->has_udm == _FALSE_) || (index_md != ppt->index_md_scalars))
+    return _SUCCESS_;
+
+  if (ppw->udm_strict_reinit_done == _TRUE_)
+    return _SUCCESS_;
+
+  /* The matching state is the exact-KG left
+     limit at the unchanged physical handoff scale factor, never a spline
+     whose stencil crosses into the averaged-background branch. */
+  class_call(background_at_z_udm_kg_left(pba,
+                                         perturbations_udm_z_fluid_transition(pba),
+                                         normal_info,
+                                         &(ppw->last_index_back),
+                                         ppw->pvecback),
+             pba->error_message,
+             ppt->error_message);
+
+  a = ppw->pvecback[pba->index_bg_a];
+  rho_udm = ppw->pvecback[pba->index_bg_rho_udm];
+  p_udm = ppw->pvecback[pba->index_bg_p_udm];
+  phi_prime_udm = ppw->pvecback[pba->index_bg_phi_prime_udm];
+  theta_denominator = rho_udm + p_udm;
+  rho_post_background = rho_udm;
+  p_post_background = p_udm;
+  rho_plus_p_post_background = theta_denominator;
+  delta_phi_udm = ppw->pv->y[ppw->pv->index_pt_delta_phi_udm];
+  delta_phi_prime_udm = ppw->pv->y[ppw->pv->index_pt_delta_phi_prime_udm];
+
+  /* The production benchmarks use synchronous gauge. The handoff is evaluated
+     with zero local lapse correction at the accepted interval boundary. */
+  class_call(perturbations_udm_kg_stress_energy(pba,
+                                              ppt->gauge,
+                                              k,
+                                              a,
+                                              0.,
+                                              ppw->pvecback[pba->index_bg_phi_udm],
+                                              phi_prime_udm,
+                                              delta_phi_udm,
+                                              delta_phi_prime_udm,
+                                              rho_udm,
+                                              p_udm,
+                                              &delta_udm,
+                                              &theta_udm,
+                                              &delta_p_udm),
+             ppt->error_message,
+             ppt->error_message);
+
+  theta_kg_candidate = theta_udm;
+  ppw->udm_theta_kg_finite =
+    ((fabs(theta_denominator) > 1.e-60) &&
+     (fabs(phi_prime_udm) > 1.e-80) &&
+     isfinite(theta_kg_candidate)) ? 1. : 0.;
+
+  theta_reinit_used = 0.; /* UDM default and fallback theta reinit value. */
+  active_delta_udm = 0.;
+  active_theta_udm = 0.;
+
+  if (!isfinite(delta_udm) || !isfinite(theta_udm) ||
+      (fabs(delta_udm) > 1.e8) || (fabs(theta_udm) > 1.e8)) {
+    ppw->udm_matching_candidate = _FALSE_;
+    ppw->udm_delta_match = 0.;
+    ppw->udm_theta_match = 0.;
+    ppw->udm_delta_post_initial = 0.;
+    ppw->udm_theta_post_initial = 0.;
+    delta_udm = 0.;
+    theta_udm = 0.;
+  }
+  else {
+    ppw->udm_matching_candidate = _FALSE_;
+    ppw->udm_delta_match = delta_udm;
+    if (ppw->udm_theta_kg_finite == 1.) {
+      theta_reinit_used = theta_kg_candidate;
+    }
+    else {
+      theta_reinit_used = 0.;
+    }
+    theta_udm = theta_reinit_used;
+
+    /* Accepted-boundary averaged matching. It uses averaged KG density and
+       momentum for delta/theta and falls back to the instantaneous state if a
+       finite-state guard fails. */
+    ppw->udm_avg_active_fallback_reason = 0.;
+    stage2c_average_available = perturbations_udm_stage2c_pre_switch_average(
+      k,
+      &stage2c_avg_rho,
+      &stage2c_avg_p,
+      &stage2c_avg_delta_rho,
+      &stage2c_avg_momentum,
+      &stage2c_avg_delta_p);
+    if ((pba->udm_averaged_matching == udm_avg_match_active) &&
+        (stage2c_average_available == _TRUE_)) {
+      class_alloc(pvecback_fluid,pba->bg_size_normal*sizeof(double),ppt->error_message);
+      class_call(background_at_z_udm_efa_right(pba,
+                                               perturbations_udm_z_fluid_transition(pba),
+                                               normal_info,
+                                               &(ppw->last_index_back),
+                                               pvecback_fluid),
+                 pba->error_message,
+                 ppt->error_message);
+      rho_post_background = pvecback_fluid[pba->index_bg_rho_udm];
+      p_post_background = pvecback_fluid[pba->index_bg_p_udm];
+      rho_plus_p_post_background = rho_post_background+p_post_background;
+      free(pvecback_fluid);
+      pvecback_fluid = NULL;
+
+      ppw->udm_avg_delta_rho = stage2c_avg_delta_rho;
+      ppw->udm_avg_momentum = stage2c_avg_momentum;
+      ppw->udm_avg_delta_p = stage2c_avg_delta_p;
+      ppw->udm_avg_finite_flag = 1.;
+      active_delta_udm = stage2c_avg_delta_rho/rho_post_background;
+      active_theta_udm = stage2c_avg_momentum/rho_plus_p_post_background;
+      delta_udm = active_delta_udm;
+      theta_udm = active_theta_udm;
+      theta_reinit_used = theta_udm;
+    }
+    else if (pba->udm_averaged_matching == udm_avg_match_active) {
+      if (ppw->udm_avg_finite_flag != 1.) {
+        ppw->udm_avg_active_fallback_reason = 1.; /* non-finite averaged state */
+      }
+      else if (ppw->udm_avg_sample_count_used < 3.) {
+        ppw->udm_avg_active_fallback_reason = 2.; /* insufficient samples */
+      }
+      else if ((!isfinite(ppw->udm_avg_delta_rho)) ||
+               (!isfinite(ppw->udm_avg_momentum))) {
+        ppw->udm_avg_active_fallback_reason = 3.; /* non-finite averaged density/momentum */
+      }
+      else if ((!isfinite(rho_udm)) || (fabs(rho_udm) < 1.e-300)) {
+        ppw->udm_avg_active_fallback_reason = 4.; /* invalid fluid density */
+      }
+      else {
+        active_delta_udm = ppw->udm_avg_delta_rho/rho_udm;
+        if (fabs(theta_denominator) < 1.e-60) {
+          ppw->udm_avg_active_fallback_reason = 5.; /* rho+p floor */
+        }
+        else {
+          active_theta_udm = ppw->udm_avg_momentum/theta_denominator;
+        }
+        if (ppw->udm_avg_active_fallback_reason == 0.) {
+          if ((!isfinite(active_delta_udm)) || (!isfinite(active_theta_udm)) ||
+              (fabs(active_delta_udm) > 1.e8) || (fabs(active_theta_udm) > 1.e8)) {
+            ppw->udm_avg_active_fallback_reason = 6.; /* active delta/theta guard */
+          }
+          else {
+            delta_udm = active_delta_udm;
+            theta_udm = active_theta_udm;
+            theta_reinit_used = theta_udm;
+          }
+        }
+      }
+    }
+
+    ppw->udm_theta_match = theta_udm;
+    ppw->udm_delta_post_initial = delta_udm;
+    ppw->udm_theta_post_initial = theta_udm;
+  }
+
+  ppw->udm_matching_done = _TRUE_;
+  ppw->udm_strict_reinit_done = _TRUE_; /* route UDM strict path separately from smooth fallback. */
+  ppw->pv->y[ppw->pv->index_pt_delta_udm] = delta_udm;
+  ppw->pv->y[ppw->pv->index_pt_theta_udm] = theta_udm;
+  /* keep accepted KG variables finite through UDM. They have
+     zero RHS in the post-oscillation branch, and resetting them sharply at
+     tau_osc can introduce a numerical boundary jump before UDM
+     removes the legacy smooth path cleanly. */
+
+  return _SUCCESS_;
+}
