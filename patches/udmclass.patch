diff --git a/source/background.c b/source/background.c
index 87d60c619bb97c641f0f5cc9be0e37810f01beab..c90d15b5c539106487d20f1f1126852f04ae7fb8 100644
--- a/source/background.c
+++ b/source/background.c
@@ -114,6 +114,181 @@
 
 #include "background.h"
 
+/* UDM dedicated UDM background helpers. The physical dimensionless
+   coupling is udm_lambda.  The canonical code-level KG coefficient is
+   udm_lambda_kg_class=3*udm_lambda*Mpl_red_CLASS^2, so V has units Mpc^-2. */
+static double background_udm_V(
+                               struct background * pba,
+                               double phi
+                               ) {
+  return 0.5*pba->udm_m*pba->udm_m*phi*phi
+    + 0.25*pba->udm_lambda_kg_class*pow(phi,4);
+}
+
+static double background_udm_dV(
+                                struct background * pba,
+                                double phi
+                                ) {
+  return pba->udm_m*pba->udm_m*phi
+    + pba->udm_lambda_kg_class*pow(phi,3);
+}
+
+static double background_udm_w_averaged(
+                                        struct background * pba,
+                                        double a
+                                        ) {
+  double a_m, x, x_m, width, s_m;
+
+  a_m = 1./(1.+pba->udm_z_m);
+  width = pba->udm_transition_width;
+
+  if (a <= 0.)
+    return -1.;
+
+  x = log(a);
+  x_m = log(a_m);
+  s_m = 0.5*(1.+tanh((x-x_m)/width));
+
+  return 1./3.*(1.-s_m);
+}
+
+static double background_udm_integral_from_aosc(
+                                                struct background * pba
+                                                ) {
+  double a_osc, a_m, x_osc, x_m, width, integral_s_m;
+
+  a_osc = 1./(1.+pba->udm_z_osc);
+  a_m = 1./(1.+pba->udm_z_m);
+  width = pba->udm_transition_width;
+  x_osc = log(a_osc);
+  x_m = log(a_m);
+
+  /* integral from a_osc to 1 of 3(1+w)dln(a), with
+     w = (1/3)(1-s_m). */
+  integral_s_m = 0.5*((0.-x_osc)+width*(log(cosh((0.-x_m)/width))-log(cosh((x_osc-x_m)/width))));
+
+  return 4.*log(1./a_osc) - integral_s_m;
+}
+
+static double background_udm_shoot_phi_from_rho(
+                                                struct background * pba,
+                                                double rho
+                                                ) {
+  double b, disc, y;
+
+  b = 0.5*pba->udm_m*pba->udm_m;
+
+  if (pba->udm_lambda_kg_class <= 0.) {
+    y = rho/b;
+  }
+  else {
+    disc = sqrt(b*b + pba->udm_lambda_kg_class*rho);
+    y = 2.*rho/(b+disc);
+  }
+
+  return sqrt(MAX(y,0.));
+}
+
+static int background_initial_conditions_with_udm_phi(
+                                                       struct precision *ppr,
+                                                       struct background *pba,
+                                                       double *pvecback,
+                                                       double *pvecback_integration,
+                                                       short use_phi_override,
+                                                       double phi_override,
+                                                       double *loga_ini
+                                                       );
+
+static int background_udm_integrate_abundance_trial(
+                                                     struct precision *ppr,
+                                                     struct background *pba,
+                                                     struct background_parameters_and_workspace *pbpaw,
+                                                     double *pvecback_integration,
+                                                     int *used_in_output,
+                                                     int (*generic_evolver)(EVOLVER_PROTOTYPE),
+                                                     double loga_final,
+                                                     double phi_ini,
+                                                     double *Omega_udm_realized,
+                                                     double *loga_ini
+                                                     );
+
+/* Integrate one complete background trial from freshly constructed initial
+   conditions. An integration failure is returned as an error; it is never
+   interpreted as either sign of the abundance residual. */
+static int background_udm_integrate_abundance_trial(
+                                                     struct precision *ppr,
+                                                     struct background *pba,
+                                                     struct background_parameters_and_workspace *pbpaw,
+                                                     double *pvecback_integration,
+                                                     int *used_in_output,
+                                                     int (*generic_evolver)(EVOLVER_PROTOTYPE),
+                                                     double loga_final,
+                                                     double phi_ini,
+                                                     double *Omega_udm_realized,
+                                                     double *loga_ini
+                                                     ) {
+
+  int index_loga;
+  double rho_udm_final, rho_crit_final;
+
+  class_test(!isfinite(phi_ini) || (phi_ini <= 0.),
+             pba->error_message,
+             "UDM abundance trial requires finite phi_ini > 0, got %.17e.",
+             phi_ini);
+
+  /* This call recomputes a_ini, the radiation-dominance check, H_ini, and all
+     H-dependent initial integrated quantities for this amplitude. */
+  class_call(background_initial_conditions_with_udm_phi(ppr,
+                                                         pba,
+                                                         pbpaw->pvecback,
+                                                         pvecback_integration,
+                                                         _TRUE_,
+                                                         phi_ini,
+                                                         loga_ini),
+             pba->error_message,
+             pba->error_message);
+
+  for (index_loga=0; index_loga<pba->bt_size; index_loga++) {
+    pba->loga_table[index_loga] = *loga_ini
+      + index_loga*(loga_final-*loga_ini)/(pba->bt_size-1);
+    used_in_output[index_loga] = 1;
+  }
+
+  class_call(generic_evolver(background_derivs,
+                             *loga_ini,
+                             loga_final,
+                             pvecback_integration,
+                             used_in_output,
+                             pba->bi_size,
+                             pbpaw,
+                             ppr->tol_background_integration,
+                             ppr->smallest_allowed_variation,
+                             background_timescale,
+                             ppr->background_integration_stepsize,
+                             pba->loga_table,
+                             pba->bt_size,
+                             background_sources,
+                             NULL,
+                             pba->error_message),
+             pba->error_message,
+             pba->error_message);
+
+  rho_udm_final = pba->background_table[(pba->bt_size-1)*pba->bg_size
+                                        +pba->index_bg_rho_udm];
+  rho_crit_final = pba->background_table[(pba->bt_size-1)*pba->bg_size
+                                         +pba->index_bg_rho_crit];
+  class_test(!isfinite(rho_udm_final) || !isfinite(rho_crit_final) ||
+             (rho_udm_final < 0.) || (rho_crit_final <= 0.),
+             pba->error_message,
+             "UDM abundance trial ended with invalid rho_udm=%.17e or rho_crit=%.17e.",
+             rho_udm_final,
+             rho_crit_final);
+
+  *Omega_udm_realized = rho_udm_final/rho_crit_final;
+
+  return _SUCCESS_;
+}
+
 /**
  * Background quantities at given redshift z.
  *
@@ -254,6 +429,115 @@ int background_at_tau(
   return _SUCCESS_;
 }
 
+/**
+ * Branch-aware background evaluation on the exact-KG side
+ * of the UDM background handoff.  Within the final four retained KG rows,
+ * use a local cubic Lagrange polynomial in log(a) made exclusively from
+ * pre-switch samples.  This avoids importing the averaged-fluid right limit
+ * through the ordinary global spline.  Away from that boundary, retain the
+ * standard background interpolation path unchanged.
+ */
+int background_at_z_udm_kg_left(
+                                struct background *pba,
+                                double z,
+                                enum vecback_format return_format,
+                                int * last_index,
+                                double * pvecback
+                                ) {
+  int pvecback_size, index_right, index_left, index_node, index_other, index_bg;
+  double loga, loga_switch, weight;
+
+  loga = -log(1.+z);
+  loga_switch = log(1./(1.+pba->udm_z_osc));
+
+  if ((pba->has_udm == _FALSE_) || (loga > loga_switch))
+    return background_at_z(pba,z,return_format,inter_normal,last_index,pvecback);
+
+  index_right = 0;
+  while ((index_right < pba->bt_size) &&
+         (pba->loga_table[index_right] < loga_switch))
+    index_right++;
+  index_left = index_right-1;
+
+  if ((index_left < 3) || (loga < pba->loga_table[index_left-3]))
+    return background_at_z(pba,z,return_format,inter_normal,last_index,pvecback);
+
+  if (return_format == normal_info)
+    pvecback_size = pba->bg_size_normal;
+  else if (return_format == short_info)
+    pvecback_size = pba->bg_size_short;
+  else
+    pvecback_size = pba->bg_size;
+
+  for (index_bg=0; index_bg<pvecback_size; index_bg++)
+    pvecback[index_bg] = 0.;
+
+  for (index_node=index_left-3; index_node<=index_left; index_node++) {
+    weight = 1.;
+    for (index_other=index_left-3; index_other<=index_left; index_other++) {
+      if (index_other != index_node)
+        weight *= (loga-pba->loga_table[index_other])
+          /(pba->loga_table[index_node]-pba->loga_table[index_other]);
+    }
+    for (index_bg=0; index_bg<pvecback_size; index_bg++)
+      pvecback[index_bg] += weight*pba->background_table[index_node*pba->bg_size+index_bg];
+  }
+
+  /* a is known exactly from the interpolation argument and should not inherit
+     a polynomial roundoff error. */
+  pvecback[pba->index_bg_a] = exp(loga);
+  *last_index = index_left;
+
+  return _SUCCESS_;
+}
+
+/* UDM counterpart of background_at_z_udm_kg_left():
+   evaluate the averaged-fluid right limit using only post-switch rows. */
+int background_at_z_udm_efa_right(
+                                  struct background *pba,
+                                  double z,
+                                  enum vecback_format return_format,
+                                  int * last_index,
+                                  double * pvecback
+                                  ) {
+  int pvecback_size, index_right, index_node, index_other, index_bg;
+  double loga, loga_switch, weight;
+
+  loga = -log(1.+z);
+  loga_switch = log(1./(1.+pba->udm_z_osc));
+  index_right = 0;
+  while ((index_right < pba->bt_size) &&
+         (pba->loga_table[index_right] < loga_switch))
+    index_right++;
+
+  if ((pba->has_udm == _FALSE_) || (index_right+3 >= pba->bt_size) ||
+      (loga > pba->loga_table[index_right+3]))
+    return background_at_z(pba,z,return_format,inter_normal,last_index,pvecback);
+
+  if (return_format == normal_info)
+    pvecback_size = pba->bg_size_normal;
+  else if (return_format == short_info)
+    pvecback_size = pba->bg_size_short;
+  else
