+/* Finite relative mismatch measure used by matching guards. */
+static double perturbations_udm_safe_jump_ratio(
+                                               double pre,
+                                               double post
+                                               ) {
+  double floor, denom, ratio;
+
+  floor = 1.e-300;
+  if ((!isfinite(pre)) || (!isfinite(post)))
+    return 0.;
+
+  denom = MAX(MAX(fabs(pre),fabs(post)),floor);
+  ratio = fabs(post-pre)/denom;
+  if (!isfinite(ratio))
+    return 0.;
+
+  return ratio;
+}
