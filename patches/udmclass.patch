+/* Accumulate the pre-transition window used by active averaged matching. */
+static int perturbations_udm_accumulate_matching_average(
+                                                                 struct background * pba,
+                                                                 struct perturbations * ppt,
+                                                                 enum possible_gauges gauge,
+                                                                 double k,
+                                                                 double a,
+                                                                 double a_prime_over_a,
+                                                                 double psi,
+                                                                 double phi,
+                                                                 double phi_prime,
+                                                                 double delta_phi,
+                                                                 double delta_phi_prime,
+                                                                 double rho_udm,
+                                                                 double p_udm,
+                                                                 double delta_match_strict,
+                                                                 double theta_match_strict,
+                                                                 double delta_p_match_strict,
+                                                                 struct perturbations_workspace * ppw
+                                                                 ) {
+  double a_fluid, a_start, a_end, a_m, a2, k2, V_phi;
+  double kinetic_piece, potential_piece, delta_rho, delta_p, momentum_source;
+  double rho_plus_p, theta_candidate, n, strict_delta_rho, strict_momentum;
+  double fluid_delta_p, theta_post, w_udm, dw_over_da_udm, w_prime_udm;
+  double cs2_udm, ca2_udm, one_plus_w_udm;
+
+  if ((pba->has_udm == _FALSE_) || (pba->udm_averaged_matching == udm_avg_match_no))
+    return _SUCCESS_;
+
+  a_fluid = perturbations_udm_a_fluid_transition(pba);
+  a_start = a_fluid*exp(-pba->udm_averaged_matching_window_lna);
+  a_end = a_fluid;
+  a_m = 1./(1.+pba->udm_z_m);
+
+
+  if ((!isfinite(a_start)) || (!isfinite(a_end)) || (a_start <= 0.) ||
+      (a_start >= a_end) || (a_fluid >= a_m)) {
+    return _SUCCESS_;
+  }
+
+  if ((a < a_start) || (a >= a_end))
+    return _SUCCESS_;
+
+  a2 = a*a;
+  k2 = k*k;
+  V_phi = pba->udm_m*pba->udm_m*phi + pba->udm_lambda_kg_class*phi*phi*phi;
+  kinetic_piece = phi_prime*delta_phi_prime/a2;
+  potential_piece = V_phi*delta_phi;
+  delta_rho = kinetic_piece + potential_piece;
+  delta_p = kinetic_piece - potential_piece;
+  if (gauge == newtonian) {
+    delta_rho -= phi_prime*phi_prime*psi/a2;
+    delta_p -= phi_prime*phi_prime*psi/a2;
+  }
+  momentum_source = k2*phi_prime*delta_phi/a2;
+  rho_plus_p = rho_udm + p_udm;
+  theta_candidate = (fabs(rho_plus_p) > 1.e-60) ? momentum_source/rho_plus_p : 0.;
+  if (!isfinite(theta_candidate)) {
+    theta_candidate = 0.;
+  }
+
+  if (!isfinite(delta_rho) || !isfinite(delta_p) || !isfinite(momentum_source) ||
+      !isfinite(kinetic_piece) || !isfinite(potential_piece) ||
+      !isfinite(rho_plus_p)) {
+    return _SUCCESS_;
+  }
+
+  w_udm = perturbations_udm_w_averaged(pba,a);
+  cs2_udm = perturbations_udm_cs2(pba,k,a,rho_udm);
+  one_plus_w_udm = 1.+w_udm;
+  ca2_udm = w_udm;
+  if ((one_plus_w_udm > 1.e-12) && (k2 > 0.) && (a_prime_over_a != 0.)) {
+    dw_over_da_udm = perturbations_udm_dw_over_da_averaged(pba,a);
+    w_prime_udm = dw_over_da_udm*a_prime_over_a*a;
+    ca2_udm = w_udm - w_prime_udm/3./one_plus_w_udm/a_prime_over_a;
+    if (!isfinite(ca2_udm))
+      ca2_udm = w_udm;
+  }
+  theta_post = theta_candidate;
+  fluid_delta_p = cs2_udm*delta_rho;
+  if ((one_plus_w_udm > 1.e-12) && (k2 > 0.) && (a_prime_over_a != 0.))
+    fluid_delta_p += (cs2_udm-ca2_udm)*(3.*a_prime_over_a*rho_plus_p*theta_post/k2);
+  if (!isfinite(fluid_delta_p)) {
+    fluid_delta_p = 0.;
+  }
+
+  if (ppw->udm_avg_sample_count_used <= 0.) {
+    ppw->udm_avg_delta_p_min = delta_p;
+    ppw->udm_avg_delta_p_max = delta_p;
+  }
+  if (delta_p < ppw->udm_avg_delta_p_min)
+    ppw->udm_avg_delta_p_min = delta_p;
+  if (delta_p > ppw->udm_avg_delta_p_max)
+    ppw->udm_avg_delta_p_max = delta_p;
+
+  n = ppw->udm_avg_sample_count_used + 1.;
+  ppw->udm_avg_delta_rho += (delta_rho-ppw->udm_avg_delta_rho)/n;
+  ppw->udm_avg_momentum += (momentum_source-ppw->udm_avg_momentum)/n;
+  ppw->udm_avg_delta_p += (delta_p-ppw->udm_avg_delta_p)/n;
+  ppw->udm_avg_fluid_delta_p +=
+    (fluid_delta_p-ppw->udm_avg_fluid_delta_p)/n;
+  ppw->udm_avg_delta_p_sq_avg += (delta_p*delta_p-ppw->udm_avg_delta_p_sq_avg)/n;
+  ppw->udm_avg_sample_count_used = n;
+
+  strict_delta_rho = delta_match_strict*rho_udm;
+  strict_momentum = theta_match_strict*rho_plus_p;
+  ppw->udm_avg_density_mismatch =
+    perturbations_udm_safe_jump_ratio(ppw->udm_avg_delta_rho,strict_delta_rho);
+  ppw->udm_avg_momentum_jump =
+    perturbations_udm_safe_jump_ratio(ppw->udm_avg_momentum,strict_momentum);
+  ppw->udm_avg_pressure_jump =
+    perturbations_udm_safe_jump_ratio(ppw->udm_avg_delta_p,
+                                      ppw->udm_avg_fluid_delta_p);
+  ppw->udm_avg_delta_p_rms = sqrt(MAX(ppw->udm_avg_delta_p_sq_avg,0.));
+  ppw->udm_avg_finite_flag =
+    (isfinite(ppw->udm_avg_delta_rho) &&
+     isfinite(ppw->udm_avg_momentum) &&
+     isfinite(ppw->udm_avg_delta_p) &&
+     isfinite(ppw->udm_avg_fluid_delta_p) &&
+     isfinite(ppw->udm_avg_pressure_jump) &&
+     isfinite(ppw->udm_avg_density_mismatch) &&
+     isfinite(ppw->udm_avg_momentum_jump) &&
+     isfinite(ppw->udm_avg_delta_p_rms)) ? 1. : 0.;
+
+  return _SUCCESS_;
+}
