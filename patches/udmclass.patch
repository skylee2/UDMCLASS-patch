+/* UDM perturbation-transition boundary. */
+static double perturbations_udm_a_fluid_transition(
+                                                   struct background * pba
+                                                   ) {
+  return 1./(1.+pba->udm_z_osc);
+}
+
+/* UDM perturbation-transition redshift helper. */
+static double perturbations_udm_z_fluid_transition(
+                                                   struct background * pba
+                                                   ) {
+  return pba->udm_z_osc;
+}
