+/* UDM helper for the dedicated UDM averaged-fluid perturbation.
+   This mirrors the UDM background w(a) after z_osc. */
+static double perturbations_udm_w_averaged(
+                                           struct background * pba,
+                                           double a
+                                           ) {
+  double a_m, width, y_m, s_m;
+
+  if (a <= 0.)
+    return 0.;
+
+  a_m = 1./(1.+pba->udm_z_m);
+  width = pba->udm_transition_width;
+  y_m = (log(a)-log(a_m))/width;
+  s_m = 0.5*(1.+tanh(y_m));
+
+  return (1.-s_m)/3.;
+}
+
+/* derivative dw/da for the UDM averaged-fluid regime. */
+static double perturbations_udm_dw_over_da_averaged(
+                                                    struct background * pba,
+                                                    double a
+                                                    ) {
+  double a_m, width, y_m;
+
+  if (a <= 0.)
+    return 0.;
+
+  a_m = 1./(1.+pba->udm_z_m);
+  width = pba->udm_transition_width;
+  y_m = (log(a)-log(a_m))/width;
+
+  if (fabs(y_m) > 20.)
+    return 0.;
+
+  return -1./(6.*width*a*pow(cosh(y_m),2));
+}
