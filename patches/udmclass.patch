+/* UDM potential curvature in UDM CLASS units. */
+static double perturbations_udm_V_phiphi(
+                                         struct background * pba,
+                                         double phi
+                                         ) {
+  return pba->udm_m*pba->udm_m + 3.*pba->udm_lambda_kg_class*phi*phi;
+}
+
+/* Convert KG field variables to fluid-like density, momentum, and pressure. */
+static int perturbations_udm_kg_stress_energy(
+                                            struct background * pba,
+                                            enum possible_gauges gauge,
+                                            double k,
+                                            double a,
+                                            double psi,
+                                            double phi,
+                                            double phi_prime,
+                                            double delta_phi,
+                                            double delta_phi_prime,
+                                            double rho_udm,
+                                            double p_udm,
+                                            double * delta_udm,
+                                            double * theta_udm,
+                                            double * delta_p_udm
+                                            ) {
+  double a2, V_phi, delta_rho, delta_p, rho_plus_p_theta, rho_plus_p;
+
+  a2 = a*a;
+  V_phi = pba->udm_m*pba->udm_m*phi + pba->udm_lambda_kg_class*phi*phi*phi;
+
+  delta_rho = phi_prime*delta_phi_prime/a2 + V_phi*delta_phi;
+  delta_p = phi_prime*delta_phi_prime/a2 - V_phi*delta_phi;
+  if (gauge == newtonian)
+    delta_rho -= phi_prime*phi_prime*psi/a2;
+  if (gauge == newtonian)
+    delta_p -= phi_prime*phi_prime*psi/a2;
+
+  rho_plus_p_theta = k*k*phi_prime*delta_phi/a2;
+  rho_plus_p = rho_udm + p_udm;
+
+  if ((rho_udm > 0.) && isfinite(delta_rho))
+    *delta_udm = delta_rho/rho_udm;
+  else
+    *delta_udm = 0.;
+
+  if ((fabs(rho_plus_p) > 1.e-60) && (fabs(phi_prime) > 1.e-80) && isfinite(rho_plus_p_theta))
+    *theta_udm = rho_plus_p_theta/rho_plus_p;
+  else
+    *theta_udm = 0.;
+
+  if (!isfinite(*delta_udm))
+    *delta_udm = 0.;
+  if (!isfinite(*theta_udm))
+    *theta_udm = 0.;
+  if (delta_p_udm != NULL) {
+    if (isfinite(delta_p))
+      *delta_p_udm = delta_p;
+    else
+      *delta_p_udm = 0.;
+  }
+
+  return _SUCCESS_;
+}
