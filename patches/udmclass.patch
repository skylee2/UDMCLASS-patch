+/* UDM calibrated matching values. Each entry is the quadratic
+   local-envelope extrapolation of the last 16 complete proper-time-weighted
+   KG cycles, constructed offline using only samples with a<a_switch. */
+static int perturbations_udm_stage2c_pre_switch_average(
+                                                        double k,
+                                                        double * avg_rho,
+                                                        double * avg_p,
+                                                        double * avg_delta_rho,
+                                                        double * avg_momentum,
+                                                        double * avg_delta_p
+                                                        ) {
+  static const double kval[5] = {0.5,1.0,1.2,1.5,2.0};
+  static const double rho[5] = {1.395789701050e11,1.395789635925e11,1.395789601057e11,1.395789693188e11,1.395789654156e11};
+  static const double pressure[5] = {4.652963033607e10,4.652801205200e10,4.652453527187e10,4.652469674984e10,4.652963028137e10};
+  static const double delta_rho[5] = {-2.115253131047e9,-8.400352097288e9,-1.245127532127e10,-1.908949440096e10,-3.362272462002e10};
+  static const double momentum[5] = {-2.785568577018e7,-4.381203455814e8,-9.216304221511e8,-2.241298666203e9,-7.025705780438e9};
+  static const double delta_p[5] = {-7.404452277921e8,-2.934826028578e9,-4.359869034440e9,-6.742427459930e9,-1.173164347920e10};
+  int index;
+
+  for (index=0; index<5; index++) {
+    if (fabs(k-kval[index]) <= 1.e-10*MAX(1.,kval[index])) {
+      *avg_rho = rho[index];
+      *avg_p = pressure[index];
+      *avg_delta_rho = delta_rho[index];
+      *avg_momentum = momentum[index];
+      *avg_delta_p = delta_p[index];
+      return _TRUE_;
+    }
+  }
+  return _FALSE_;
+}
